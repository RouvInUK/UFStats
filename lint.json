[A-Z_]/u.","line":2,"column":8,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":10,"suggestions":[{"messageId":"removeVar","data":{"varName":"fs"},"fix":{"range":[61,69],"text":""},"desc":"Remove unused variable 'fs'."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { pipeline, env } from '@xenova/transformers';\nimport fs from 'fs';\nenv.allowLocalModels = false;\n\nasync function run() {\n  console.log(\"Loading model...\");\n  let transcriber = await pipeline('automatic-speech-recognition', 'Xenova/whisper-tiny.en');\n  \n  // 1 second of random noise\n  let fakeAudio = new Float32Array(16000 * 1);\n  for (let i = 0; i < fakeAudio.length; i++) {\n    fakeAudio[i] = (Math.random() * 2 - 1) * 0.1; \n  }\n\n  console.log(\"Transcribing with NO chunk_length_s...\");\n  try {\n    let output1 = await transcriber(fakeAudio, { \n      language: 'english', \n      task: 'transcribe',\n      return_timestamps: false\n    });\n    console.log(\"Output1:\", output1);\n  } catch(e) { console.error(\"Error1:\", e); }\n  \n  console.log(\"Transcribing WITH chunk_length_s...\");\n  try {\n    let output2 = await transcriber(fakeAudio, { \n      language: 'english', \n      task: 'transcribe',\n      chunk_length_s: 30,\n      stride_length_s: 5,\n      return_timestamps: false\n    });\n    console.log(\"Output2:\", output2);\n  } catch(e) { console.error(\"Error2:\", e); }\n}\nrun().catch(console.error);\n","usedDeprecatedRules":[]},{"filePath":"/Users/rouven/Documents/UFStats/test_audio4.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/rouven/Documents/UFStats/test_audio5.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedR